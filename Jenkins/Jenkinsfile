def sendSlack(String message) {
    sh """
        set +x
        SLACK_WEBHOOK=\$(aws secretsmanager get-secret-value \\
            --secret-id "netflix-clone/prod/cicd-secrets" \\
            --query SecretString --output text | jq -r .SLACK_WEBHOOK)
        curl -s -X POST -H 'Content-type: application/json' \\
            --data '{"text":"${message}"}' \\
            "\$SLACK_WEBHOOK" > /dev/null
    """
}

pipeline {
    agent any

    tools {
        jdk 'jdk21'
        nodejs 'nodejs18'
    }

    environment {
        SCANNER_HOME    = tool 'sonar-server'
        ECR_REGISTRY    = '177884821045.dkr.ecr.us-east-1.amazonaws.com'
        ECR_REPO        = 'netflix-clone'
        AWS_REGION      = 'us-east-1'
        MANIFESTS_REPO  = 'https://github.com/RPriest/netflix-manifests.git'
        DOJO_URL        = 'http://172.31.27.183:8080'
        ENGAGEMENT_ID   = '1'
        APP_DIR         = 'Application-Code'
    }

    stages {

        stage('Clean Workspace') {
            steps { cleanWs() }
        }

        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/RPriest/Netflix-Clone-K8S-End-to-End-Project.git'
            }
        }

        stage('Gitleaks Secret Scan') {
            steps {
                sh 'gitleaks detect --source . --report-format json --report-path gitleaks-report.json --no-git --verbose || true'
            }
            post { always { archiveArtifacts artifacts: 'gitleaks-report.json', allowEmptyArchive: true } }
        }

        stage('SonarQube Analysis') {
            steps {
                sh '''
                    set +x

                    SONAR_HOST_URL="http://localhost:9000"

                    SONAR_TOKEN=$(aws secretsmanager get-secret-value \
                        --secret-id "netflix-clone/prod/cicd-secrets" \
                        --query SecretString \
                        --output text | jq -r .SONAR_TOKEN)

                    echo "Starting SonarQube analysis..."

                    $SCANNER_HOME/bin/sonar-scanner \
                        -Dsonar.host.url=$SONAR_HOST_URL \
                        -Dsonar.projectName=Netflix-Clone \
                        -Dsonar.projectKey=Netflix-Clone \
                        -Dsonar.sources=Application-Code/src \
                        -Dsonar.login=$SONAR_TOKEN

                    echo "SonarQube analysis submitted."
                '''
            }
        }

        stage('SonarQube Quality Gate') {
            steps {
                sh '''
                    set +x

                    SONAR_HOST_URL="http://localhost:9000"

                    SONAR_TOKEN=$(aws secretsmanager get-secret-value \
                        --secret-id "netflix-clone/prod/cicd-secrets" \
                        --query SecretString \
                        --output text | jq -r .SONAR_TOKEN)

                    REPORT_FILE=".scannerwork/report-task.txt"

                    if [ ! -f "$REPORT_FILE" ]; then
                        echo "ERROR: report-task.txt not found."
                        exit 1
                    fi

                    CE_TASK_URL=$(grep '^ceTaskUrl=' "$REPORT_FILE" | cut -d= -f2-)

                    if [ -z "$CE_TASK_URL" ]; then
                        echo "ERROR: Unable to determine SonarQube task URL."
                        exit 1
                    fi

                    echo "Waiting for SonarQube analysis to complete..."

                    while true
                    do
                        RESPONSE=$(curl -s -u "$SONAR_TOKEN:" "$CE_TASK_URL")

                        STATUS=$(echo "$RESPONSE" | jq -r '.task.status')

                        echo "Current status: $STATUS"

                        case "$STATUS" in
                            SUCCESS)
                                ANALYSIS_ID=$(echo "$RESPONSE" | jq -r '.task.analysisId')
                                break
                                ;;
                            FAILED|CANCELED)
                                echo "SonarQube Compute Engine task failed."
                                exit 1
                                ;;
                            PENDING|IN_PROGRESS)
                                sleep 5
                                ;;
                            *)
                                echo "Unexpected status: $STATUS"
                                echo "$RESPONSE"
                                exit 1
                                ;;
                        esac
                    done

                    QUALITY_GATE=$(curl -s -u "$SONAR_TOKEN:" \
                        "$SONAR_HOST_URL/api/qualitygates/project_status?analysisId=$ANALYSIS_ID" \
                        | jq -r '.projectStatus.status')

                    echo "Quality Gate Result: $QUALITY_GATE"

                    if [ "$QUALITY_GATE" != "OK" ]; then
                        echo "Quality Gate FAILED."

                        curl -s -u "$SONAR_TOKEN:" \
                            "$SONAR_HOST_URL/api/qualitygates/project_status?analysisId=$ANALYSIS_ID" | jq

                        exit 1
                    fi

                    echo "Quality Gate PASSED."

                    echo "Exporting issues for DefectDojo..."
                    curl -s -u "$SONAR_TOKEN:" \
                        "$SONAR_HOST_URL/api/issues/search?componentKeys=Netflix-Clone&resolved=false&ps=500" \
                        -o sonar-report.json
                '''
            }
            post { always { archiveArtifacts artifacts: 'sonar-report.json', allowEmptyArchive: true } }
        }

        stage('Install Dependencies') {
            steps {
                dir("${APP_DIR}") {
                    sh 'yarn install --frozen-lockfile'
                }
            }
        }

        stage('NJSScan SAST') {
            steps {
                dir("${APP_DIR}") {
                    sh 'njsscan --json -o njsscan-report.json . || true'
                }
            }
            post { always { archiveArtifacts artifacts: "${APP_DIR}/njsscan-report.json", allowEmptyArchive: true } }
        }

        stage('Semgrep SAST') {
            steps {
                sh 'semgrep ci --config p/owasp-top-ten --config p/cwe-top-25 --json -o semgrep-report.json || true'
            }
            post { always { archiveArtifacts artifacts: 'semgrep-report.json', allowEmptyArchive: true } }
        }

        stage('OWASP Dependency Check') {
    steps {
        dir('Application-Code') {
            sh '''
                mkdir -p dependency-check-report
            '''

            dependencyCheck additionalArguments: '''
                --scan .
                --format JSON
                --format SARIF
                --format XML
                --out dependency-check-report
            ''',
            odcInstallation: 'owasp-dp-check'

            dependencyCheckPublisher pattern: 'dependency-check-report/dependency-check-report.xml'

            archiveArtifacts artifacts: 'dependency-check-report/**/*', fingerprint: true
        }
    }
}

        stage('RetireJS') {
            steps {
                dir("${APP_DIR}") {
                    sh 'retire --path ./node_modules --outputformat json --outputpath retirejs-report.json --severity medium || true'
                }
            }
            post { always { archiveArtifacts artifacts: "${APP_DIR}/retirejs-report.json", allowEmptyArchive: true } }
        }

        stage('Trivy Filesystem Scan') {
            steps {
                dir("${APP_DIR}") {
                    sh '''
                        trivy fs --severity HIGH,CRITICAL --ignore-unfixed --format json -o trivy-fs-report.json . || true
                        trivy fs --severity HIGH,CRITICAL --ignore-unfixed . > trivyfs.txt 2>&1 || true
                        cat trivyfs.txt
                    '''
                }
            }
            post { always { archiveArtifacts artifacts: "${APP_DIR}/trivy-fs-report.json,${APP_DIR}/trivyfs.txt", allowEmptyArchive: true } }
        }

        stage('Kaniko Build & Push') {
            steps {
                sh '''
                    set +x
                    TMDB_API_KEY=$(aws secretsmanager get-secret-value \
                        --secret-id "netflix-clone/prod/cicd-secrets" \
                        --query SecretString --output text | jq -r .TMDB_API_KEY)

                    ECR_PASSWORD=$(aws ecr get-login-password --region ${AWS_REGION})
                    AUTH=$(printf "AWS:%s" "$ECR_PASSWORD" | base64 -w0)

                    mkdir -p kaniko-docker-config
                    cat > kaniko-docker-config/config.json <<EOF
{
  "auths": {
    "${ECR_REGISTRY}": {
      "auth": "${AUTH}"
    }
  }
}
EOF

                    # Shared directory so the digest file survives after the
                    # ephemeral --rm Kaniko container exits. Writing it to
                    # the container's own /tmp (as before) loses the file
                    # the moment the container is removed.
                    mkdir -p kaniko-digest

                    docker run --rm \
                      -v "$WORKSPACE/Application-Code":/workspace \
                      -v "$WORKSPACE/kaniko-docker-config/config.json":/kaniko/.docker/config.json:ro \
                      -v "$WORKSPACE/kaniko-digest":/kaniko-digest \
                      gcr.io/kaniko-project/executor:latest \
                      --context /workspace \
                      --dockerfile /workspace/Dockerfile \
                      --build-arg TMDB_V3_API_KEY=$TMDB_API_KEY \
                      --destination ${ECR_REGISTRY}/${ECR_REPO}:${BUILD_NUMBER} \
                      --destination ${ECR_REGISTRY}/${ECR_REPO}:latest \
                      --digest-file=/kaniko-digest/image-digest.txt

                    rm -rf kaniko-docker-config
                    echo "Kaniko build and push complete"
                '''
                script {
                    env.IMAGE_DIGEST = readFile("${WORKSPACE}/kaniko-digest/image-digest.txt").trim()
                }
            }
            post {
                always {
                    sh 'rm -rf "$WORKSPACE/kaniko-digest" || true'
                }
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh '''
                    trivy image --severity HIGH,CRITICAL --ignore-unfixed --format json -o trivy-image-report.json ${ECR_REGISTRY}/${ECR_REPO}:${BUILD_NUMBER} || true
                    trivy image --severity HIGH,CRITICAL ${ECR_REGISTRY}/${ECR_REPO}:${BUILD_NUMBER} > trivyimage.txt 2>&1 || true
                    cat trivyimage.txt
                '''
            }
            post { always { archiveArtifacts artifacts: 'trivy-image-report.json,trivyimage.txt', allowEmptyArchive: true } }
        }

        stage('Cosign Sign Image') {
            steps {
                withCredentials([file(credentialsId: 'cosign-private-key', variable: 'COSIGN_KEY')]) {
                    sh '''
                        set +x
                        export COSIGN_PASSWORD=$(aws secretsmanager get-secret-value \
                            --secret-id "netflix-clone/prod/cicd-secrets" \
                            --query SecretString --output text | jq -r .COSIGN_PASSWORD)

                        ECR_PASSWORD=$(aws ecr get-login-password --region ${AWS_REGION})
                        AUTH=$(printf "AWS:%s" "$ECR_PASSWORD" | base64 -w0)

                        export DOCKER_CONFIG="$WORKSPACE/cosign-docker-config"
                        mkdir -p "$DOCKER_CONFIG"
                        cat > "$DOCKER_CONFIG/config.json" <<EOF
{
  "auths": {
    "${ECR_REGISTRY}": {
      "auth": "${AUTH}"
    }
  }
}
EOF

                        cosign sign --key $COSIGN_KEY ${ECR_REGISTRY}/${ECR_REPO}@${IMAGE_DIGEST}

                        rm -rf "$DOCKER_CONFIG"
                        echo "Image signed with Cosign"
                    '''
                }
            }
        }

        stage('Generate SBOM') {
    steps {
        dir("${APP_DIR}") {
            sh '''
                mkdir -p .cdxgen-temp
                docker run --rm --user "$(id -u):$(id -g)" \
                  -v "$(pwd)":/app:rw \
                  -e CDXGEN_TEMP_DIR=/app/.cdxgen-temp \
                  ghcr.io/cyclonedx/cdxgen:latest -o /app/sbom.cyclonedx.json /app

                if [ ! -f sbom.cyclonedx.json ]; then
                    echo "ERROR: SBOM generation failed"
                    exit 1
                fi

                osv-scanner --sbom sbom.cyclonedx.json --format json > osv-scanner-report.json || true
                echo 'SBOM generated'
            '''
        }
    }
    post { always { archiveArtifacts artifacts: "${APP_DIR}/sbom.cyclonedx.json,${APP_DIR}/osv-scanner-report.json", allowEmptyArchive: true } }
}

        stage('Update Manifests Repo') {
            steps {
                sh '''
                    set +x
                    GITHUB_TOKEN=$(aws secretsmanager get-secret-value \
                        --secret-id "netflix-clone/prod/cicd-secrets" \
                        --query SecretString --output text | jq -r .GITHUB_TOKEN)

                    ASKPASS_SCRIPT=$(mktemp)
                    trap 'rm -f "$ASKPASS_SCRIPT"' EXIT
                    cat > "$ASKPASS_SCRIPT" <<'EOS'
#!/bin/sh
echo "$GIT_ASKPASS_TOKEN"
EOS
                    chmod 700 "$ASKPASS_SCRIPT"
                    export GIT_ASKPASS_TOKEN="$GITHUB_TOKEN"
                    export GIT_ASKPASS="$ASKPASS_SCRIPT"

                    git clone https://x-access-token@github.com/RPriest/netflix-manifests.git
                    cd netflix-manifests
                    git config user.email jenkins@devsecops.local
                    git config user.name "Jenkins CI"

                    sed -i "s|image: ${ECR_REGISTRY}/${ECR_REPO}:.*|image: ${ECR_REGISTRY}/${ECR_REPO}:${BUILD_NUMBER}|g" kubernetes/deployment.yml

                    git add kubernetes/deployment.yml

                    if git diff --cached --quiet; then
                        echo "No changes to manifest — image tag already up to date, skipping commit."
                    else
                        git commit -m "ci: update image to build ${BUILD_NUMBER}"
                        git push origin main
                        echo "Manifests updated --- ArgoCD will sync"
                    fi

                    unset GIT_ASKPASS_TOKEN GIT_ASKPASS
                '''
            }
        }

        stage('Wait for ArgoCD Sync') {
            steps {
                sh '''
                    set +x
                    ARGOCD_TOKEN=$(aws secretsmanager get-secret-value \
                        --secret-id "netflix-clone/prod/cicd-secrets" \
                        --query SecretString --output text | jq -r .ARGOCD_TOKEN)

                    argocd app wait netflix-clone \
                      --sync --health \
                      --timeout 180 \
                      --auth-token "$ARGOCD_TOKEN" \
                      --server a4d4cb25818fa42aea50627797f6c075-1681677328.us-east-1.elb.amazonaws.com \
                      --insecure \
                      --grpc-web
                '''
            }
        }

        stage('Wait for Target Health') {
    steps {
        sh '''
            set +x
            TG_ARN=$(aws elbv2 describe-target-groups --region ${AWS_REGION} \
              --query "TargetGroups[?contains(TargetGroupName, 'netflix')].TargetGroupArn" \
              --output text)

            if [ -z "$TG_ARN" ]; then
                echo "ERROR: could not find target group"
                exit 1
            fi

            echo "Waiting for targets on $TG_ARN to become healthy..."

            for i in $(seq 1 18); do
                UNHEALTHY=$(aws elbv2 describe-target-health --region ${AWS_REGION} \
                  --target-group-arn "$TG_ARN" \
                  --query "length(TargetHealthDescriptions[?TargetHealth.State!='healthy'])" \
                  --output text)

                TOTAL=$(aws elbv2 describe-target-health --region ${AWS_REGION} \
                  --target-group-arn "$TG_ARN" \
                  --query "length(TargetHealthDescriptions)" \
                  --output text)

                echo "Attempt $i: $UNHEALTHY unhealthy / $TOTAL total"

                if [ "$UNHEALTHY" = "0" ] && [ "$TOTAL" != "0" ]; then
                    echo "All targets healthy."
                    exit 0
                fi

                sleep 10
            done

            echo "ERROR: targets did not become healthy in time. Current state:"
            aws elbv2 describe-target-health --region ${AWS_REGION} --target-group-arn "$TG_ARN"
            exit 1
        '''
    }
}

        stage('ZAP DAST Scan') {
            steps {
                sh '''
                    ALB_URL=$(aws elbv2 describe-load-balancers --region ${AWS_REGION} \
                      --query "LoadBalancers[?contains(LoadBalancerName, 'netflix')].DNSName" \
                      --output text)
                    echo "Scanning: http://${ALB_URL}"
                    docker run -v $(pwd):/zap/wrk/:rw --user root --network=host \
                      ghcr.io/zaproxy/zaproxy:stable zap-baseline.py \
                      -t http://${ALB_URL} -J zap-baseline-report.json -r zap-baseline-report.html -x zap-baseline-report.xml -m 5 || true
                '''
            }
            post { always { archiveArtifacts artifacts: 'zap-*.json,zap-*.html,zap-*.xml', allowEmptyArchive: true } }
        }

        stage('Upload to DefectDojo') {
            steps {
                timeout(time: 60, unit: 'SECONDS') {
                    sh '''
                        set +x
                        DEFECTDOJO_TOKEN=$(aws secretsmanager get-secret-value \
                            --secret-id "netflix-clone/prod/cicd-secrets" \
                            --query SecretString --output text | jq -r .DEFECTDOJO_TOKEN)

                        pip3 install requests 2>/dev/null || true
                        DOJO_URL=${DOJO_URL} DOJO_TOKEN=${DEFECTDOJO_TOKEN} ENGAGEMENT_ID=${ENGAGEMENT_ID} python3 upload-to-defectdojo.py
                    ''' 
                }
            }
        }
    }

    post {
        success {
            script {
                sendSlack(":white_check_mark: *SUCCESS* ${env.JOB_NAME} #${env.BUILD_NUMBER} | Image: ${env.ECR_REGISTRY}/${env.ECR_REPO}:${env.BUILD_NUMBER} | ${env.BUILD_URL}")
            }
        }
        failure {
            script {
                sendSlack(":x: *FAILED* ${env.JOB_NAME} #${env.BUILD_NUMBER} | Stage: ${env.STAGE_NAME} | ${env.BUILD_URL}console")
            }
        }
    }
}
