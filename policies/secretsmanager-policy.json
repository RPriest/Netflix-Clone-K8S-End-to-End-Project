{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SecretsManagerAccess",
      "Effect": "Allow",
      "Action": ["secretsmanager:GetSecretValue", "secretsmanager:DescribeSecret"],
      "Resource": ["arn:aws:secretsmanager:us-east-1:<AWS_ACCOUNT_ID>:secret:netflix-clone/prod/cicd-secrets*"]
    },
    {
      "Sid": "AppSecretsKeyDecrypt",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "arn:aws:kms:us-east-1:<AWS_ACCOUNT_ID>:key/<APP_KMS_KEY_ID>"
    }
  ]
}
